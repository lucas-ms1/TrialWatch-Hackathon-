{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trialwatch-prep:cases:1.0",
  "title": "Evidence-first prosecution review queue",
  "description": "Generic preparation contract; not an official hackathon schema. Records support human review and do not determine guilt, legal compliance, or case merit. Use null for unknown dates and review metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"},
    "text": {"type": "string", "minLength": 1},
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "date": {"type": ["string", "null"], "format": "date"},
    "timestamp": {"type": "string", "format": "date-time"},
    "translation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["text", "language", "method", "reviewer"],
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "method": {"enum": ["human", "machine"]},
        "reviewer": {"$ref": "#/$defs/nullableText"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url", "publisher", "published_date", "retrieved_at", "language"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "publisher": {"$ref": "#/$defs/text"},
        "published_date": {"$ref": "#/$defs/date"},
        "retrieved_at": {"$ref": "#/$defs/timestamp"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "quote", "locator", "translation"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "quote": {"$ref": "#/$defs/text"},
        "locator": {"$ref": "#/$defs/text"},
        "translation": {"$ref": "#/$defs/translation"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "kind", "text", "event_date", "evidence"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["prosecution_trigger", "procedural_event", "alleged_conduct", "context"]},
        "text": {"$ref": "#/$defs/text"},
        "event_date": {"$ref": "#/$defs/date"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "status": {"enum": ["pending", "in_review", "needs_sources", "ready_for_expert_review"]},
        "reviewer": {"$ref": "#/$defs/nullableText"},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"$ref": "#/$defs/nullableText"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "synthetic", "title", "country_code", "sources", "claims", "review"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "synthetic": {"type": "boolean"},
        "title": {"$ref": "#/$defs/text"},
        "country_code": {"enum": ["BN", "KH", "ID", "LA", "MY", "MM", "PH", "SG", "TH", "TL", "VN"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
